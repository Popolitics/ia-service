# Copier en .env pour modifier un réglage. Valeurs par défaut : rag_an/config.py.

# LLM (Ollama)
RAG_OLLAMA_URL=http://localhost:11434
RAG_LLM_MODEL=mistral

# Embeddings
RAG_EMBED_MODEL=OrdalieTech/Solon-embeddings-large-0.1
RAG_EMBED_DIM=1024
# RAG_EMBED_DEVICE=cuda

# PostgreSQL (docker-compose.yml)
RAG_PG_HOST=localhost
RAG_PG_PORT=55432
RAG_PG_USER=rag
RAG_PG_PASSWORD=rag
RAG_PG_DATABASE=rag
RAG_PG_TABLE=an_chunks

# MongoDB (docker-compose.yml)
RAG_MONGO_URI=mongodb://localhost:27017
RAG_MONGO_DB=rag_an

# Recherche
RAG_TOP_K=20
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_CONTEXT_TOKEN_BUDGET=1500

# Changer de modèle d'embedding ou de taille de chunk impose : uv run rag-ingest docs/ --reset
# RAG_CHUNK_MAX_TOKENS=192
